  SP1["acme-payments-prd<br/>service project"]
  SP2["acme-data-platform-prd<br/>service project"]

  subgraph HOST["acme-host-prd — Shared VPC host project"]
    direction TB
    NET["shared-prd<br/>VPC · GLOBAL routing<br/>auto_create_subnetworks = false"]
    SUB1["payments-europe-west4<br/>primary 10.0.0.0/20<br/>pods 10.64.0.0/16<br/>services 10.80.0.0/20<br/>Private Google Access on"]
    SUB2["data-platform-europe-west4<br/>primary 10.0.16.0/20<br/>pods 10.65.0.0/16<br/>services 10.80.16.0/20<br/>Private Google Access on"]
    NET --> SUB1
    NET --> SUB2
  end

  FW -.->|attached at production folder<br/>evaluated before VPC rules| NET

  SP1 -->|compute.networkUser| SUB1
  SP2 -->|compute.networkUser| SUB2

